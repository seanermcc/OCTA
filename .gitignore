# Python caches and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Editors and operating-system files
.idea/
.vscode/
.claude/settings.local.json
.claude/*.lock
.DS_Store
Thumbs.db
desktop.ini

# OCT source data and generated binary artifacts
*.RAW
*.raw
*.mat
*.h5
*.hdf5
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx

# Generated outputs may contain large derived data and human annotations.
# Keep documentation reports, but leave all other output artifacts local.
outputs/**
!outputs/**/
!outputs/**/*.md

# Versioned applications live alongside their local datasets. Preserve their
# executable source and launchers without publishing arrays or human labels.
!outputs/**/*.py
!outputs/**/*.cmd
!outputs/**/*.bat
!outputs/**/*.ps1
!outputs/**/gallery_template.html
!outputs/**/gallery-review.js
!outputs/octo-vessel_onh_v2/manual_gallery_template.html
!outputs/octo-vessel_onh_v2/check_manual_gallery.cjs
outputs/vessel_manual_gallery_preview/

# Mac reviewer build inputs are source, not generated data.
!outputs/mac_boundary_20260923/support/start_mac.sh
!outputs/mac_boundary_20260923/support/requirements-mac.txt
!outputs/mac_boundary_20260923/OPEN_BOUNDRY_REVIEWER_MAC.command

# Keep local pre-update recovery copies out of the published application.
outputs/archived/
outputs/git_pull_backup_*/
outputs/shared_reviews_20260930/before/

# Disposable project copies created by release path-verification tests.
outputs/**/verification/paths*/

# Local logs and one-off machine migration helper
*.log
organize.bat
